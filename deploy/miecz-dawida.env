# Ustawienia serwera. Po zmianie: systemctl restart miecz-dawida
PORT=7777
# Tryb gry: podboj, pvp, deathmatch, czolgi
MODE=podboj
# Mapa: stare_miasto, pole_bitwy, rynek, ziemia_niczyja, neonowa_dzielnica, stacja_rdzen, dolina_pancerna.
# Puste oznacza domyslna mape trybu.
MAP=
# Liczebnosc kazdej druzyny. Boty uzupelniaja braki.
BOTS=12
# 0 Rekrut, 1 Weteran, 2 Elita
DIFFICULTY=1
# Ziarno mapy. Klient dostaje je od serwera.
SEED=1943
