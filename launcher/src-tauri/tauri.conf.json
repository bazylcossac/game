{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corp Wars Launcher",
  "mainBinaryName": "CorpWars-Launcher",
  "version": "0.1.0",
  "identifier": "com.corpwars.launcher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Corp Wars Launcher",
      "width": 1100,
      "height": 800,
      "minWidth": 760,
      "minHeight": 640,
      "backgroundColor": "#0c0e14",
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "Pobieraj, aktualizuj i uruchamiaj Corp Wars",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["Polish", "English"], "displayLanguageSelector": false }
    }
  }
}
